{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "predev": "npm run prepare:vision",
    "dev": "node scripts/dev.mjs",
    "predev:fake": "npm run prepare:vision",
    "dev:fake": "node scripts/dev.mjs --fake-db",
    "dev:frontend": "npm run prepare:vision && vite",
    "prebuild": "npm run prepare:vision",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:auto-ui": "playwright test --config tests/auto-ui/playwright.config.ts",
    "test:auto-real": "playwright test --config tests/auto-ui/real-model.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
