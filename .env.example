# Server-side only. Export in the calling server process; no dotenv loader is used.
# Use a long random token for local service-to-service access.
FACETRACE_API_TOKEN=
FACETRACE_DATA_DIR=.facetrace-data
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Keep SDK body logging disabled for real subject metadata.
TYPESAFE_LOG_LEVEL=warning
