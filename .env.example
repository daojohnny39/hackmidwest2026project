# Copy to .env for local settings; never commit a real .env. The pipeline reads
# .env only for variables not already exported, and CLI flags win over both.
# Defaults are offline (mock search, fake Jev, no LLM). Values here never permit
# external calls by themselves: live search needs --live, real models need --models.
# No search, cloud, or model credentials are needed for the mock service.

# Search (Section 1): mock or serpapi. serpapi requires --live, which selects it.
SEARCH_BACKEND=mock
# Loopback origin of `python3 -m mock_internet serve`. The standalone mock client
# reads only the exported variable, not this file.
MOCK_INTERNET_URL=http://127.0.0.1:8765
# default, ambiguous, stale, duplicates, empty, rate_limited, server_error
MOCK_SCENARIO=default
# Delay for mock search requests only, 0-5000.
MOCK_DELAY_MS=0

# Live search (--live): SerpApi key and a private S3 bucket for temporary image hosting.
SERPAPI_KEY=
IMAGE_BUCKET=
# Region for the bucket and for Bedrock. AWS credentials come from the standard
# AWS chain (aws configure, AWS_PROFILE, or exported variables), not from this file.
AWS_REGION=

# Jev (Sections 2-3): fake, typesafe, openrouter, off. typesafe/openrouter need --models.
JEV_MODE=fake
# Blank uses the route default: jev-latest (typesafe) or typesafe/jev-1.13 (openrouter).
JEV_MODEL=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Strands LLM (Sections 1-4): off, anthropic, bedrock. anthropic/bedrock need --models.
LLM_MODE=off
# Blank uses claude-sonnet-5-5 for anthropic. Bedrock needs its own model ID here;
# never reuse an Anthropic API ID. Bedrock does not use ANTHROPIC_API_KEY.
LLM_MODEL=
ANTHROPIC_API_KEY=
