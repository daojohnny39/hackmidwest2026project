# Server-side only. Export these variables before starting the adapter.
# Use a long random token for local service-to-service access.
FACETRACE_API_TOKEN=
FACETRACE_DATA_DIR=.facetrace-data
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Copy to .env for local settings; never commit a real .env. The pipeline reads
# .env only for variables not already exported, and CLI flags win over both.
# `python -m pipeline set-key serpapi` (or facecheck, ...) creates .env from this file
# if needed and saves the key with hidden input, so it never lands in shell history.
# Search defaults to backend V3 (rekognition): SerpApi web search, with every result's
# face checked by Amazon Rekognition. SEARCH_BACKEND=facecheck uses FaceCheck face search,
# SEARCH_BACKEND=serpapi uses Yandex alone through SerpApi, and `run --mock` (or
# SEARCH_BACKEND=mock) uses the local mock internet, which needs no credentials. Jev and
# the LLM default to fake/off, and real models also need --models.

# Search (Section 1): rekognition (default, V3), facecheck, serpapi, or mock.
SEARCH_BACKEND=rekognition
# Loopback origin of `python3 -m mock_internet serve`. The standalone mock client
# reads only the exported variable, not this file.
MOCK_INTERNET_URL=http://127.0.0.1:8765
# default, ambiguous, stale, duplicates, empty, rate_limited, server_error
MOCK_SCENARIO=default
# Delay for mock search requests only, 0-5000.
MOCK_DELAY_MS=0

# FaceCheck API token, required for facecheck search. Set it with
# `python -m pipeline set-key facecheck`. Each search costs 3 credits ($0.30).
FACECHECK_API_KEY=
# true: free demo searches over only the first 100,000 faces (results aren't meaningful).
FACECHECK_DEMO=false

# SerpApi key, required for rekognition and serpapi search. Set it with
# `python -m pipeline set-key serpapi`.
SERPAPI_KEY=
# V3 only: SerpApi engines to search, comma-separated (yandex_images, google_lens).
# Each one costs one SerpApi search per image.
REKOGNITION_ENGINES=yandex_images,google_lens
# V3 only: drop results whose face is less similar than this (0-100, Rekognition
# CompareFaces similarity; 80 is CompareFaces' own default).
REKOGNITION_MIN_SIMILARITY=80
# How SerpApi runs give the search engine a public image URL (spec 1.2): tunnel (default;
# a localhost.run SSH tunnel to this machine, needs only ssh) or s3 (needs IMAGE_BUCKET).
IMAGE_HOST=tunnel
# Private S3 bucket for IMAGE_HOST=s3 (unverified with Yandex). Images are deleted after each search.
IMAGE_BUCKET=
# Region for Rekognition (required for V3), the bucket, and Bedrock. AWS credentials come
# from the standard AWS chain (~/.aws/credentials, AWS_PROFILE, or exported variables), not from this file.
# `python -m pipeline set-key aws --region us-east-1` saves the keys there and sets this.
AWS_REGION=

# Jev (Sections 2-3): fake, typesafe, openrouter, off. typesafe/openrouter need --models.
JEV_MODE=fake
# Blank uses the route default: jev-latest (typesafe) or typesafe/jev-1.13 (openrouter).
JEV_MODEL=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Strands LLM (Sections 1-4): off, anthropic, bedrock. anthropic/bedrock need --models.
LLM_MODE=off
# Blank uses claude-sonnet-5-5 for anthropic. Bedrock needs its own model ID here;
# never reuse an Anthropic API ID. Bedrock does not use ANTHROPIC_API_KEY.
LLM_MODEL=
ANTHROPIC_API_KEY=
